# AutoAI Showroom - Environment Configuration Template
APP_ENV=development

# Database Configuration (PostgreSQL 17)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auto_marketing_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auto_marketing_db

# Web Server Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Scraper Settings
SCRAPER_BASE_URL=https://sahibinden.com
SPOTI_CAR_URL=https://www.spoticar.com.tr
SCRAPER_TIMEOUT=10
MAX_SCRAPE_ITEMS=50
