# Arkas 2. El Pazarlama AI - Environment Variables
APP_ENV=development

# Database Configuration (PostgreSQL 17 - DBeaver Compatible)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_username
DB_PASSWORD=your_password
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/your_db_name

# Web Server Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Scraper Settings
SCRAPER_BASE_URL=your_scrape_url
SPOTI_CAR_URL=your_spotify_car_url
SCRAPER_TIMEOUT=10
MAX_SCRAPE_ITEMS=50
